# ==========================================
# PROSADA .gitignore
# ==========================================

# --- Environment & Secret Variables ---
.env
.env.local
.env.*.local
*.env
!.env.example
prosada/backend/.env
prosada/frontend/.env

# --- Node & Frontend Dependencies / Build ---
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
*.local
.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# --- Python & Backend Cache ---
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
downloads/
eggs/
.eggs/
/lib/
/lib64/
!prosada/frontend/src/lib/**
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
.venv/
**/venv/
**/env/
**/.venv/
ENV/

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# --- Jupyter Notebooks ---
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# --- IDEs & Code Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs & Temp ---
*.log
*.tmp
temp/
scratch/

