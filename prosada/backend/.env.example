# Alamat frontend (untuk CORS). Saat deploy, isi dengan URL production (mis. https://prosada.vercel.app)
FRONTEND_URL="http://localhost:5173"

# Kunci API Groq untuk fitur AI Chatbot & Knowledge Graph (dapatkan gratis di https://console.groq.com)
GROQ_API_KEY=""

# Model LLM Groq (opsional, bawaan: openai/gpt-oss-120b atau llama-3.3-70b-versatile)
GROQ_MODEL="openai/gpt-oss-120b"

# Folder dataset Knowledge Graph (kosongkan untuk menggunakan default prosada/backend/data)
DATA_DIR=""
